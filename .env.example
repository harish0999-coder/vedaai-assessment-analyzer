# Google Gemini API key (https://aistudio.google.com/app/apikey) - free tier works
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB connection string (MongoDB Atlas free tier works)
# Example: mongodb+srv://user:pass@cluster0.mongodb.net/vedaai?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# Database name (optional, defaults to "vedaai")
MONGODB_DB=vedaai
